# =====================================================================
# TicTacToe backend (T05B) — пример переменных окружения.
# Docker:  cp .env.example .env && docker compose up --build
# Значения ниже — ТОЛЬКО для локальной разработки. Для любого другого
# окружения замените пароль БД и SECRET_KEY_JWT на собственные.
# =====================================================================

# ---------- PostgreSQL (имена совпадают с ${DB_*} в application.properties) ----------
DB_NAME=tictactoe
DB_USER=tictactoe
DB_PASSWORD=tictactoe_dev_password
# Порт БД на хосте (контейнер всегда слушает 5432); проброс только на 127.0.0.1
DB_HOST_PORT=15432

# JDBC URL нужен только при запуске приложения ВНЕ Docker (gradle bootRun / java -jar).
# В docker compose URL собирается автоматически: jdbc:postgresql://db:5432/${DB_NAME}
DB_URL=jdbc:postgresql://localhost:15432/tictactoe

# ---------- JWT ----------
# Ключ подписи HS256 для access/refresh токенов. Минимум 32 символа (256 бит),
# иначе приложение не сможет выпустить токен (WeakKeyException).
# Сгенерировать: openssl rand -base64 48
SECRET_KEY_JWT=dev-only-secret-change-me-0123456789abcdef0123456789

# ---------- Порт API на хосте ----------
# Внутри контейнера всегда 8080. Если меняете, укажите тот же адрес
# в поле «Адрес сервера API» в game.html.
APP_PORT=8080

# ---------- JVM ----------
# Используется только в контейнере (читается в ENTRYPOINT через $JAVA_OPTS).
# Для удалённой отладки добавьте:
#   -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
JAVA_OPTS=-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError
