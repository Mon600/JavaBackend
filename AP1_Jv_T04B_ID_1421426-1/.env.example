# =====================================================================
# TicTacToe backend (T04B) — пример переменных окружения.
# Docker:  cp .env.example .env && docker compose up --build
# Значения ниже — ТОЛЬКО для локальной разработки. Для любого другого
# окружения замените пароль БД на собственный.
# =====================================================================

# ---------- PostgreSQL ----------
DB_NAME=springdb
DB_USER=postgres
DB_PASSWORD=postgres_dev_password
# Порт БД на хосте (контейнер всегда слушает 5432); проброс только на 127.0.0.1
DB_HOST_PORT=15432

# ---------- Порт API на хосте ----------
# Внутри контейнера всегда 8080. game.html этого проекта жёстко использует
# http://localhost:8080, поэтому при смене порта поправьте API_BASE в game.html.
APP_PORT=8080

# ---------- JVM ----------
# Используется только в контейнере (читается в ENTRYPOINT через $JAVA_OPTS).
# Значение в кавычках, чтобы файл можно было загрузить в shell: set -a; source .env; set +a
# Для удалённой отладки добавьте:
#   -agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005
JAVA_OPTS="-XX:MaxRAMPercentage=75.0 -XX:+ExitOnOutOfMemoryError"
